MONGODB_URI="mongodb://127.0.0.1:27017/wraglet"

# NextAuth - to generate a secret key, run `openssl rand -base64 32` in the terminal or `npx auth secret`
AUTH_SECRET="your-secret-key"
# AUTH_DEBUG="true"  # verbose Auth.js logs (off by default; can retain memory in dev)
ABLY_API_KEY="your-ably-api-key"

# Cloudflare
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_ACCESS_KEY_ID="your-cloudflare-access-key-id"
CLOUDFLARE_SECRET_ACCESS_KEY="your-cloudflare-secret-access-key"
CLOUDFLARE_R2_USERS_BUCKET_NAME="your-cloudflare-users-bucket-name"

NEXT_PUBLIC_R2_USERS_URL="your-r2-users-url"
NEXT_PUBLIC_R2_FILES_URL="your-r2-files-url"

# App URL (verify + password reset links)
NEXT_PUBLIC_APP_URL="http://localhost:5000"

# Resend (transactional verify + password reset)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Wraglet <auth@wraglet.com>"
# Verify wraglet.com at https://resend.com/domains (SPF/DKIM) before go-live.
# Until verified, Resend only delivers to your Resend account email — not Gmail/etc.

# Cloudflare Turnstile (signup + forgot password)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="..."
# TURNSTILE_SECRET_KEY="..."
# Auth rate limits use MongoDB (rate_limits collection, TTL index). Set RATE_LIMIT_MEMORY=1 to force in-memory limits locally.

# Trust backfill scripts (local/ops only — never on deploy)
# TRUST_BACKFILL_ENABLED="true"

# Playwright E2E (optional, local / CI test DB only)
# Password must match sign-up rules: 8+ chars, upper, lower, digit, special from @$!%*?&#
# E2E_SEED_ENABLED must be true to allow `yarn seed:e2e` to write to MongoDB (Playwright sets it during global setup).
# The seed script refuses NODE_ENV=production and VERCEL_ENV=production; it is not part of `next build` / deploy.
# E2E_CAPTURE_AUTH_TOKENS="1"
# Playwright sets this automatically via playwright.config.ts (never on production).
# E2E_TEST_USER_EMAIL="e2e-test@wraglet.local"
# E2E_TEST_USER_PASSWORD="choose-a-strong-local-only-password"
# Only if you must override email to a non-@wraglet.local address in an isolated DB:
# E2E_SEED_ALLOW_ANY_EMAIL="true"
# Optional if @e2e_wraglet is taken by a non-E2E account:
# E2E_TEST_USER_USERNAME="@e2e_wraglet"
#
# Seed upserts a post + published blog (see e2e/fixtures/seed-constants.ts). If slug e2e-welcome-blog
# exists for another user, change that file or delete the conflicting blog.
